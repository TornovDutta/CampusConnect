# ==========================================
# CampusConnect Backend Environment Configuration Template
# Copy this file to .env and adjust variables as needed.
# ==========================================

# MongoDB Database Configuration
MONGO_URI=mongodb://localhost:27017
DATABASE_NAME=campusconnect

# JWT / Security Configuration
SECRET_KEY=replace_with_a_secure_random_secret_key
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Super Admin Account (created on startup if not existing)
ADMIN_NAME=Super Admin
ADMIN_EMAIL=admin@campusconnect.com
ADMIN_PASSWORD=Admin@123
